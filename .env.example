# Copy to .env.local and fill in. Never commit .env.local.

# --- Email delivery (required before either form can send) ---------------
# Create the account at resend.com in the CLIENT's name, then add the
# domain and its DNS records at Namecheap.
RESEND_API_KEY=

# Where procurement and spare-parts requests are delivered.
REQUEST_INBOX=

# The From address. Must be on a domain verified in Resend.
# Until the domain is verified you can send from onboarding@resend.dev,
# but it will only deliver to the address that owns the Resend account.
REQUEST_FROM="TwentyFour03 Vintage <requests@yourdomain.com>"

# --- Shop payments (Paystack, in the CLIENT's account) --------------------
# Dashboard > Settings > API Keys & Webhooks. Use the test keys first.
# Until both are set, the shop shows prices but checkout says payment is
# not switched on yet. Items also need a price in src/lib/content.ts.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# --- Content (Sanity, in the CLIENT's account) ----------------------------
# Project id and dataset from sanity.io/manage. Public dataset: reads need
# no token. The Editor token is only for scripts/migrate-sanity.ts.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=
# Shared secret for the publish webhook (Sanity > API > Webhooks), so the
# site refreshes when she publishes. Any long random string.
SANITY_REVALIDATE_SECRET=
